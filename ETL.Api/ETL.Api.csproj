<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>sistema-opiniones-etl-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- La API publica los comentarios de redes sociales (data/social_comments.csv) -->
  <ItemGroup>
    <None Include="..\data\social_comments.csv" Link="data\social_comments.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
